# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must use LF (Unix line endings)
*.sh text eol=lf

# Batch/PowerShell scripts use CRLF (Windows line endings)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# GitHub Actions workflows use LF
.github/**/*.yml text eol=lf
.github/**/*.yaml text eol=lf

# Patch files must use LF (git apply context-line matching is
# sensitive to line endings; CRLF causes failures on Windows runners).
*.patch text eol=lf
