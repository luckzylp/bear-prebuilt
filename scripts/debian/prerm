#!/bin/sh
set -e

# Pre-removal script for Bear
# This script runs before the package is removed

# Bear is installed to /usr/bin/bear
# dpkg will handle removal automatically

case "$1" in
    remove|deconfigure|upgrade|failed-upgrade)
        # No special cleanup needed
        ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
