#!/bin/sh
set -e

# Post-installation script for Bear
# This script runs after the package is installed

# Bear is installed to /usr/bin/bear (via dpkg)
# No symlink needed as /usr/bin is already in PATH

# Update man database if mandb is available
if command -v mandb >/dev/null 2>&1; then
    mandb -q 2>/dev/null || true
fi

exit 0
